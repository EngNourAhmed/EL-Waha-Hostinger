                wusta: { name: 'Al Wusta', wilayas: ['Haima', 'Duqm', 'Mahout', 'Al Jazer'] }
            },
            ar: {
                muscat: { name: 'مسقط', wilayas: ['مسقط', 'مطرح', 'بوشر', 'السيب', 'العامرات', 'قريات'] },
                dhofar: { name: 'ظفار', wilayas: ['صلالة', 'طاقة', 'مرباط', 'سدح', 'رخيوت'] },
                musandam: { name: 'مسندم', wilayas: ['خصب', 'بخا', 'دبا البayah'] },
                buraimi: { name: 'البريمي', wilayas: ['البريمي', 'محضة', 'السنينة'] },
                dakhiliyah: { name: 'الداخلية', wilayas: ['نزwa', 'بahlā', 'آدم', 'منح', 'Izki'] },
                batina_n: { name: 'شمال الباطنة', wilayas: ['صحار', 'شناص', 'Liwa', 'Saham', 'Al Khaburah'] },
                batina_s: { name: 'جنوب الباطنة', wilayas: ['Rustaq', 'Nakhal', 'Wadi Al Maawil', 'Awabi', 'Barka'] },
                sharqiyah_n: { name: 'شمال الشرقية', wilayas: ['Ibra', 'Bidiyah', 'Al Qabil', 'Wadi Bani Khalid'] },
                sharqiyah_s: { name: 'جنوب الشرقية', wilayas: ['Sur', 'Al Kamil Wal Wafi', 'Jalan Bani Bu Ali'] },
                dhahirah: { name: 'الظاهرة', wilayas: ['Ibri', 'Yanqul', 'Dhank'] },
                wusta: { name: 'الوسطى', wilayas: ['Haima', 'Duqm', 'Mahout', 'Al Jazer'] }
            }
        };

        function saveCart() {
            localStorage.setItem('oasis-cart', JSON.stringify(cart));
        }

        function saveCheckoutData() {
            sessionStorage.setItem('oasis-checkout', JSON.stringify(checkoutData));
        }

        function formatPrice(amount) {
            const t = translations[currentLang];
            return currentLang === 'ar'
                ? `${amount.toFixed(3)} ${t.currency}`
                : `${amount.toFixed(3)} OMR`;
        }

        function getCartTotal() {
            return cart.reduce((sum, item) => {
                const p = productsData[item.id];
                return p ? sum + (p.price * item.qty) : sum;
            }, 0);
        }

